{
 "id": "rti_application",
 "title": "RTI application (Right to Information)",
 "flow": "rti",
 "final_readback": true,
 "description": {
  "en": "Ask a government office for information under the RTI Act, 2005. The application is drafted for you.",
  "hi": "सूचना का अधिकार अधिनियम 2005 के तहत किसी सरकारी विभाग से जानकारी माँगिए। आवेदन आपके लिए तैयार होगा।"
 },
 "glossary": [
  "RTI",
  "Public Information Officer",
  "khasra",
  "khatauni",
  "ration card",
  "BPL",
  "MGNREGA",
  "PM Awas",
  "Aadhaar"
 ],
